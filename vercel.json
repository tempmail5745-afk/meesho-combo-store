{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/safe.html",
      "destination": "/lp"
    },
    {
      "source": "/lp",
      "destination": "/lp"
    },
    {
      "source": "/lp/:path*",
      "destination": "/lp"
    },
    {
      "source": "/home.php",
      "destination": "/home"
    },
    {
      "source": "/product.php",
      "destination": "/product"
    },
    {
      "source": "/checkout.php",
      "destination": "/checkout"
    },
    {
      "source": "/cart.php",
      "destination": "/cart"
    },
    {
      "source": "/privacy-policy.php",
      "destination": "/privacy-policy"
    },
    {
      "source": "/terms.php",
      "destination": "/terms"
    },
    {
      "source": "/refund-policy.php",
      "destination": "/refund-policy"
    },
    {
      "source": "/shipping-policy.php",
      "destination": "/shipping-policy"
    },
    {
      "source": "/contact.php",
      "destination": "/contact"
    },
    {
      "source": "/:path*.php",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}

